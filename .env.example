# ─────────────────────────────────────────────────────────────────────────────
# Legendary Branding Headless — Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is in .gitignore.
# For Oxygen, set these in the Shopify admin under Hydrogen → Environments.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Shopify storefront domain (myshopify.com domain)
PUBLIC_STORE_DOMAIN=

# Required: Public Storefront API token (safe to expose in browser)
PUBLIC_STOREFRONT_API_TOKEN=

# Required: Private Storefront API token (server-only, higher rate limits)
PRIVATE_STOREFRONT_API_TOKEN=

# Storefront ID (GID without the gid://shopify/OnlineStore/ prefix)
PUBLIC_STOREFRONT_ID=

# Storefront API version — update quarterly with Shopify releases
PUBLIC_STOREFRONT_API_VERSION=2025-04

# Customer Account API (optional — needed for account/login routes)
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# Checkout domain — usually same as store domain or custom
PUBLIC_CHECKOUT_DOMAIN=legendary-branding.com

# Session secret — generate a strong random string (e.g. openssl rand -base64 32)
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — Analytics & Monitoring
# Leave empty to disable each feature.
# ─────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 (consent-gated, loads only after user accepts)
PUBLIC_GA4_MEASUREMENT_ID=

# Meta (Facebook) Pixel (consent-gated)
PUBLIC_META_PIXEL_ID=

# TikTok Pixel (consent-gated)
PUBLIC_TIKTOK_PIXEL_ID=

# Sentry error tracking (lazy-loaded SDK)
PUBLIC_SENTRY_DSN=
