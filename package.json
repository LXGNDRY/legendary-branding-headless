{
  "name": "legendary-branding-headless",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify hydrogen dev --codegen",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "shopify hydrogen codegen",
    "preview": "shopify hydrogen preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "validate:release-env": "node scripts/validate-release-env.mjs",
    "locales:check": "python3 scripts/locales.py --check"
  },
  "type": "module",
  "dependencies": {
    "@graphql-codegen/cli": "7.4.5",
    "@sentry/react": "11.2.0",
    "@shopify/cli": "4.8.4",
    "@shopify/hydrogen": "2026.4.7",
    "graphql": "16.14.2",
    "isbot": "4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@shopify/graphql-codegen": {
      "@graphql-codegen/add": "7.1.1",
      "@graphql-codegen/typescript": "6.1.1",
      "@graphql-codegen/typescript-operations": "6.1.10"
    },
    "lodash": "4.18.1",
    "@shopify/mini-oxygen": {
      "body-parser": "1.20.6",
      "undici": "7.30.0"
    },
    "youch": {
      "cookie": "0.7.2"
    },
    "qs": "6.16.0",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
